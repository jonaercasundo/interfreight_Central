{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "interfreight/central",
  "type": "project",
  "description": "InterFreight Central freight operations platform",
  "keywords": ["laravel", "freight", "logistics"],
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0",
    "laravel/tinker": "^3.0",
    "spatie/laravel-permission": "^8.0"
  },
  "require-dev": {"fakerphp/faker": "^1.23", "laravel/pail": "^1.2", "laravel/pint": "^1.24", "mockery/mockery": "^1.6", "nunomaduro/collision": "^8.8", "phpunit/phpunit": "^12.0"},
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {"setup": ["composer install", "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"", "@php artisan key:generate", "@php artisan migrate --force", "npm install", "npm run build"], "test": "@php artisan test"},
  "extra": {"laravel": {"dont-discover": []}},
  "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true, "allow-plugins": {"php-http/discovery": true, "phpunit/phpunit": true}},
  "minimum-stability": "stable", "prefer-stable": true
}
