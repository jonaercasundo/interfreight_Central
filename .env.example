APP_NAME="InterFreight Central"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000
CACHE_STORE=file
QUEUE_CONNECTION=sync
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=ifc-
REDIS_CACHE_CONNECTION=cache
REDIS_QUEUE_CONNECTION=default
FILESYSTEM_DISK=local
IFC_CLAMAV_HOST=
IFC_CLAMAV_PORT=3310
IFC_CLAMAV_TIMEOUT=3
IFC_CLAMAV_RETRIES=1
IFC_CLAMAV_RETRY_DELAY_MS=100
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS="ifc@example.test"
MAIL_FROM_NAME="InterFreight Central"
VITE_APP_NAME="InterFreight Central"
AI_SERVICE_URL=http://127.0.0.1:8001
# Generate a private random value and use the same value for Laravel and FastAPI.
AI_SERVICE_TOKEN=
AI_SERVICE_CONNECT_TIMEOUT=3
AI_SERVICE_TIMEOUT=10
AI_SERVICE_VERIFY_TLS=true
AI_SERVICE_CA_BUNDLE=
# OpenAI is disabled until configured in Administrator settings. Keep any key out of VITE_* variables.
IFC_AI_ENABLED=false
IFC_AI_TUTORIALS_ENABLED=true
IFC_AI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=
OPENAI_TIMEOUT=20
OPENAI_CONNECT_TIMEOUT=5
OPENAI_MAX_OUTPUT_TOKENS=500
# Required for administrator-stored credentials: FastAPI must reach Laravel's signed,
# server-only credential endpoint. Use the Laravel service hostname inside Docker;
# production requires HTTPS and a trusted CA. Match AI_SERVICE_TOKEN on both services.
# When using `php artisan serve` on Windows, run scripts/start-ai-credential-endpoint.ps1
# so FastAPI can fetch credentials from a separate PHP process while Laravel waits for AI.
AI_LARAVEL_CREDENTIAL_URL=http://127.0.0.1:8002/api/internal/ai-credential
AI_LARAVEL_CREDENTIAL_CA=
# Production must use shared Redis for cross-worker replay protection.
AI_REPLAY_REDIS_URL=
# Keep false until statutory numbering, company tax data, and compliant invoice output are verified.
IFC_BILLING_LEGAL_ISSUANCE_VERIFIED=false
# Existing commercial approval controls. Leave margin limits unset absent approved policy.
IFC_LOW_MARGIN_PERCENT=
IFC_MINIMUM_MARGIN_PERCENT=
IFC_REQUIRED_QUOTATION_REVIEWS=accounting,finance
IFC_PROHIBIT_SELF_APPROVAL=true
# Finance-approved policy values must remain unconfigured until written approval and source integration exist.
IFC_FINANCE_POLICY_STATUS=unconfigured
IFC_FINANCE_APPROVAL_REFERENCE=
IFC_FINANCE_APPROVED_BY=
IFC_REVENUE_RECOGNITION_SOURCE=
IFC_FINAL_COST_ACCRUAL_METHOD=
IFC_FINANCE_FX_SOURCE=
